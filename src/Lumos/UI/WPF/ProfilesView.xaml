<UserControl x:Class="Lumos.UI.WPF.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Lumos.UI.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInSlideUpAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <wpf:ExeIconConverter x:Key="ExeIconConverter" />

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <Border x:Name="border" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource BrushBorder}" VerticalAlignment="Center">
                                <Ellipse x:Name="ellipse" Width="20" Height="20" Fill="{DynamicResource BrushSurface}" HorizontalAlignment="Left" Margin="2" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" 
                                Background="{DynamicResource BrushSurfaceMuted}" 
                                CornerRadius="12" 
                                Padding="20,15">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBorder}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,20,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Profiles" FontFamily="{StaticResource FontFamilyHeader}" FontSize="36" Margin="0,0,0,30" />

        <!-- Profile Sets Header Card -->
        <Border Grid.Row="1" Style="{DynamicResource SettingsContainerStyle}" Padding="20" Margin="0,0,0,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Load existing set" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ProfileSets}" 
                                  SelectedItem="{Binding SelectedProfileSet}" 
                                  DisplayMemberPath="Name" 
                                  Width="220"
                                  Padding="10,6"
                                  FontSize="14" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Set name" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ProfileSetName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 ToolTip="Name for the profile set. Type a new name, then click Save Set to create or update it." />
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="New Set" Command="{Binding NewSetCommand}" Background="Transparent" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,10,0" Padding="20,10" Cursor="Hand" />
                    <Button Content="Load Set" Command="{Binding LoadSetCommand}" Background="Transparent" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,10,0" Padding="20,10" Cursor="Hand" />
                    
                    <Border Background="{DynamicResource BrushPrimary}" CornerRadius="8">
                        <Button Content="Save Set" Command="{Binding SaveSetCommand}" Background="Transparent" Foreground="{DynamicResource BrushSurface}" BorderThickness="0" Padding="20,10" Cursor="Hand" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource SettingsContainerStyle}" Padding="20" Margin="0,0,0,25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,14">
                    <TextBlock Text="Browse installed apps" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"
                               ToolTip="Optional. Pick an installed app to prefill the manual fields below, then adjust the name or executable if needed." />
                    <ComboBox x:Name="InstalledAppsComboBox"
                              ItemsSource="{Binding FilteredInstalledApps}"
                              SelectedItem="{Binding SelectedInstalledApp, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding InstalledAppSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              GotKeyboardFocus="OpenInstalledAppsComboBox"
                              PreviewMouseLeftButtonDown="OpenInstalledAppsComboBox"
                              MaxDropDownHeight="280"
                              Padding="10,8"
                              FontSize="14"
                              ToolTip="Type to search installed apps, or pick one from the list. Lumos uses its executable name, such as chrome.exe, to match the active app.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28"
                                            Height="28"
                                            CornerRadius="7"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding ExeName, Converter={StaticResource ExeIconConverter}}"
                                               Width="20"
                                               Height="20"
                                               Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding ExeName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Profile name" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"
                               ToolTip="Manual field. This is only the friendly label shown in Lumos, for example Chrome or VS Code." />
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Manual field. Type any display name you want for this profile." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Executable" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"
                               ToolTip="Manual field. This must match the app process name, such as chrome.exe, code.exe, or vlc.exe." />
                    <TextBox Text="{Binding NewExeName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Manual field. Enter the executable process name Lumos should match. If you omit .exe, Lumos adds it automatically." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Brightness %" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"
                               ToolTip="Manual field. The brightness Lumos should restore when this executable becomes active." />
                    <TextBox Text="{Binding NewBrightnessText, UpdateSourceTrigger=Explicit}"
                             LostFocus="CommitBrightnessTextBox"
                             KeyDown="CommitBrightnessTextBoxOnEnter"
                             TextAlignment="Center"
                             ToolTip="Manual field. Enter a brightness percentage from 0 to 100." />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource BrushPrimary}" CornerRadius="8">
                    <Button Content="Add Profile"
                            Command="{Binding AddProfileCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushSurface}"
                            BorderThickness="0"
                            Padding="20,10"
                            Cursor="Hand"
                            ToolTip="Adds the manual profile below. Profiles are not written to disk until you click Save All Profiles or Save Set." />
                </Border>
            </Grid>
        </Border>

        <!-- Profiles List -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Profiles}" 
                 SelectedItem="{Binding SelectedProfile}"
                 ItemContainerStyle="{StaticResource ProfileItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Margin="0,0,0,20">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- App Info -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Image Source="{Binding ExeName, Converter={StaticResource ExeIconConverter}}" Width="22" Height="22" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ExeName}" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Grid>

                        <!-- Brightness Control -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0">
                            <TextBlock Text="Brightness" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0" />
                            <Slider Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Width="140" VerticalAlignment="Center" Margin="0,0,15,0" />
                            <TextBox Text="{Binding BrightnessText, UpdateSourceTrigger=Explicit}" 
                                     Width="64" 
                                     TextAlignment="Right" 
                                     FontSize="14" 
                                     FontWeight="SemiBold" 
                                     VerticalAlignment="Center" 
                                     Padding="6,4" 
                                     LostFocus="CommitBrightnessTextBox" 
                                     KeyDown="CommitBrightnessTextBoxOnEnter" />
                            <TextBlock Text="%" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>

                        <!-- Exclude Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Exclude" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Excluded}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Actions -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                    <Button Content="Delete Selected" Command="{Binding DeleteSelectedProfileCommand}" Background="Transparent" Foreground="#DC2626" BorderThickness="0" Padding="20,10" Cursor="Hand" />
                </Border>
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <Button Content="Apply Selected" Command="{Binding ApplySelectedProfileCommand}" Background="Transparent" BorderThickness="0" Padding="20,10" Cursor="Hand" />
                </Border>
            </StackPanel>

            <Border HorizontalAlignment="Right" Background="{DynamicResource BrushPrimary}" CornerRadius="12">
                <Button Content="Save All Profiles" 
                        Command="{Binding SaveCommand}"
                        Background="Transparent" 
                        Foreground="{DynamicResource BrushSurface}" 
                        Padding="25,12" 
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
