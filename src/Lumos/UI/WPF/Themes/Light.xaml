<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wispr Flow Light Theme -->
    <Color x:Key="ColorBackground">#FAF9F6</Color>
    <Color x:Key="ColorSidebar">#F3F3F0</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceMuted">#F5F5F3</Color>
    <Color x:Key="ColorTextPrimary">#1A1A1A</Color>
    <Color x:Key="ColorTextSecondary">#666666</Color>
    <Color x:Key="ColorPrimary">#1A1A1A</Color>
    <Color x:Key="ColorBorder">#EAE9E4</Color>
    <Color x:Key="ColorHover">#F0EFEB</Color>
    <Color x:Key="ColorScrollThumb">#D3D3D3</Color>
    
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushScrollThumb" Color="{StaticResource ColorScrollThumb}" />

</ResourceDictionary>
