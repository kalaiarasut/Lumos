<Window x:Class="Lumos.UI.WPF.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lumos.UI.WPF"
        xmlns:vm="clr-namespace:Lumos.ViewModels"
        mc:Ignorable="d"
        Title="Lumos" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontFamilyBody}"
        TextElement.Foreground="{StaticResource BrushTextPrimary}">
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}" />
        </EventTrigger>
    </Window.Triggers>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <local:ProfilesView />
        </DataTemplate>
        
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="15,10" Margin="10,5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0A000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSurface}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,40,0,0">
                <StackPanel Orientation="Horizontal" Margin="25,0,0,30">
                    <TextBlock Text="Lumos" FontFamily="{StaticResource FontFamilyHeader}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
                
                <RadioButton Content="Settings" 
                             Style="{StaticResource SidebarButtonStyle}" 
                             Command="{Binding NavigateToSettingsCommand}" 
                             IsChecked="True" />
                             
                <RadioButton Content="Profiles" 
                             Style="{StaticResource SidebarButtonStyle}" 
                             Command="{Binding NavigateToProfilesCommand}" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="20">
        </ContentControl>
    </Grid>
</Window>
