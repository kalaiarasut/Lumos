<UserControl x:Class="Lumos.UI.WPF.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInSlideUpAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <Style x:Key="HelpTipStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <Border x:Name="border" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource BrushBorder}" VerticalAlignment="Center">
                                <Ellipse x:Name="ellipse" Width="20" Height="20" Fill="{DynamicResource BrushSurface}" HorizontalAlignment="Left" Margin="2" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,40,40">
            <TextBlock Text="Settings" FontFamily="{StaticResource FontFamilyHeader}" FontSize="36" Margin="0,0,0,30" />
            
            <Border Style="{StaticResource SettingsContainerStyle}" Padding="30" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="General" FontFamily="{StaticResource FontFamilyHeader}" FontSize="20" Margin="0,0,0,25" />
                    
                    <CheckBox Content="Enable automation" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding AutomationEnabled}" 
                              FontSize="14"
                              Margin="0,0,0,20" />
                              
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" FontSize="14" />
                        <ComboBox SelectedValue="{Binding ThemeMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Width="100" HorizontalAlignment="Right" Padding="8,4" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <ComboBoxItem Content="light" />
                            <ComboBoxItem Content="dark" />
                        </ComboBox>
                    </Grid>
                              
                    <CheckBox Content="Start with Windows" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding StartupEnabled}" 
                              FontSize="14"
                              Margin="0,0,0,20" />
                              
                    <CheckBox Content="Enable smooth transitions" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding TransitionsEnabled}"
                              FontSize="14" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsContainerStyle}" Padding="30" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Scheduled profile preset" FontFamily="{StaticResource FontFamilyHeader}" FontSize="20" Margin="0,0,0,10" />
                    <TextBlock Text="Use a selected profile set automatically during a daily time window." Foreground="{DynamicResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,25" />

                    <CheckBox Content="Enable scheduled profile preset"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding ScheduledProfileEnabled}"
                              FontSize="14"
                              Margin="0,0,0,20"
                              ToolTip="When enabled, Lumos uses the selected profile set during the configured time range. Outside that range, normal learned profiles are used." />

                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Profile set:" VerticalAlignment="Center" FontSize="14" />
                        <ComboBox ItemsSource="{Binding ProfileSets}"
                                  SelectedValue="{Binding ScheduledProfileSetName, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding ScheduledProfileSetName, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Name"
                                  DisplayMemberPath="Name"
                                  IsEditable="True"
                                  Width="220"
                                  HorizontalAlignment="Right"
                                  Padding="8,4"
                                  Background="{DynamicResource BrushSurface}"
                                  BorderBrush="{DynamicResource BrushBorder}"
                                  BorderThickness="1"
                                  ToolTip="Select the saved profile set Lumos should use during the scheduled window." />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start time" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ScheduledProfileStartTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,4"
                                     Background="{DynamicResource BrushSurface}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     BorderBrush="{DynamicResource BrushBorder}"
                                     BorderThickness="1"
                                     ToolTip="Daily start time in 24-hour format, for example 06:00." />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End time" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ScheduledProfileEndTime, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,4"
                                     Background="{DynamicResource BrushSurface}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     BorderBrush="{DynamicResource BrushBorder}"
                                     BorderThickness="1"
                                     ToolTip="Daily end time in 24-hour format, for example 19:00. Overnight ranges like 19:00 to 06:00 are supported." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsContainerStyle}" Padding="30" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Advanced" FontFamily="{StaticResource FontFamilyHeader}" FontSize="20" Margin="0,0,0,25" />
                    
                    <Grid Margin="0,0,0,20"
                          ToolTipService.InitialShowDelay="150"
                          ToolTip="When enabled, Lumos does not change brightness if the saved value and current value are almost the same. This avoids unnecessary small brightness jumps.">
                        <CheckBox Content="Skip tiny brightness differences" 
                                  Style="{StaticResource ToggleSwitchStyle}" 
                                  IsChecked="{Binding SkipSmallBrightnessDifferences}" 
                                  FontSize="14" />
                        <Border Style="{StaticResource HelpTipStyle}"
                                HorizontalAlignment="Left"
                                Margin="220,0,0,0">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <TextBlock TextWrapping="Wrap" Text="When enabled, Lumos does not change brightness if the saved value and current value are almost the same. This avoids unnecessary small brightness jumps." />
                                </ToolTip>
                            </Border.ToolTip>
                            <TextBlock Text="?" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </Grid>
                              
                    <Grid Margin="0,0,0,20"
                          ToolTipService.InitialShowDelay="150"
                          ToolTip="The maximum percentage difference Lumos should ignore when Skip tiny brightness differences is enabled. Example: 2 means 50% and 52% are treated as close enough.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Threshold:" VerticalAlignment="Center" FontSize="14" />
                            <Border Style="{StaticResource HelpTipStyle}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="360">
                                        <TextBlock TextWrapping="Wrap" Text="The maximum percentage difference Lumos should ignore when Skip tiny brightness differences is enabled. Example: 2 means 50% and 52% are treated as close enough." />
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="?" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding SmallDifferenceThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8,4" HorizontalAlignment="Right" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                    </Grid>
                    
                    <Grid ToolTipService.InitialShowDelay="150"
                          ToolTip="After you manually change brightness, Lumos waits this many seconds before restoring app-specific brightness again. This prevents the app from fighting your manual adjustment.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Manual restore cooldown (s):" VerticalAlignment="Center" FontSize="14" />
                            <Border Style="{StaticResource HelpTipStyle}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="360">
                                        <TextBlock TextWrapping="Wrap" Text="After you manually change brightness, Lumos waits this many seconds before restoring app-specific brightness again. This prevents the app from fighting your manual adjustment." />
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="?" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding ManualChangeRestoreCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8,4" HorizontalAlignment="Right" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" />
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border Background="{DynamicResource BrushPrimary}" CornerRadius="12" HorizontalAlignment="Right">
                <Button Content="Save Settings" 
                        Command="{Binding SaveCommand}"
                        Background="Transparent" 
                        Foreground="{DynamicResource BrushSurface}" 
                        Padding="25,12" 
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
