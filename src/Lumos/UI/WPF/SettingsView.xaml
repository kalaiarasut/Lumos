<UserControl x:Class="Lumos.UI.WPF.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInSlideUpAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <Border x:Name="border" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="{StaticResource BrushBorder}" VerticalAlignment="Center">
                                <Ellipse x:Name="ellipse" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushPrimary}" />
                                <Setter TargetName="ellipse" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,40,40">
            <TextBlock Text="Settings" FontFamily="{StaticResource FontFamilyHeader}" FontSize="36" Margin="0,0,0,30" />
            
            <Border Style="{StaticResource SettingsContainerStyle}" Padding="30" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="General" FontFamily="{StaticResource FontFamilyHeader}" FontSize="20" Margin="0,0,0,25" />
                    
                    <CheckBox Content="Enable automation" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding AutomationEnabled}" 
                              FontSize="14"
                              Margin="0,0,0,20" />
                              
                    <CheckBox Content="Start with Windows" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding StartupEnabled}" 
                              FontSize="14"
                              Margin="0,0,0,20" />
                              
                    <CheckBox Content="Enable smooth transitions" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding TransitionsEnabled}"
                              FontSize="14" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsContainerStyle}" Padding="30" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Advanced" FontFamily="{StaticResource FontFamilyHeader}" FontSize="20" Margin="0,0,0,25" />
                    
                    <CheckBox Content="Skip tiny brightness differences" 
                              Style="{StaticResource ToggleSwitchStyle}" 
                              IsChecked="{Binding SkipSmallBrightnessDifferences}" 
                              FontSize="14"
                              Margin="0,0,0,20" />
                              
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Threshold:" VerticalAlignment="Center" FontSize="14" />
                        <TextBox Text="{Binding SmallDifferenceThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8,4" HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                    </Grid>
                    
                    <Grid>
                        <TextBlock Text="Manual restore cooldown (s):" VerticalAlignment="Center" FontSize="14" />
                        <TextBox Text="{Binding ManualChangeRestoreCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8,4" HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border Background="{StaticResource BrushPrimary}" CornerRadius="12" HorizontalAlignment="Right">
                <Button Content="Save Settings" 
                        Command="{Binding SaveCommand}"
                        Background="Transparent" 
                        Foreground="White" 
                        Padding="25,12" 
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
